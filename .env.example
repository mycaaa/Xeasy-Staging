# Xeasy — settings for the TEST host https://xeasy.vnrseeds.co.in
# Copy to .env (deploy/deploy.sh --first-run does this) and fill every value marked <fill>.
# Never commit .env. Secrets come from IT, not from this repository.
# Live values and the go-live switches are in deploy/GO_LIVE_ENV.md.

APP_NAME=Xeasy
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://xeasy.vnrseeds.co.in
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# The app calls its own API from the server (relay). Same host as APP_URL.
API_BASE_URL=https://xeasy.vnrseeds.co.in
API_NEW_BASE_URL=https://xeasy.vnrseeds.co.in/api
API_LOCAL_BASE_URL=https://xeasy.vnrseeds.co.in/api
# Old Xeasy API for VVNR approvals; empty = this app's own /api
XEASY_LEGACY_API_BASE_URL=
XEASY_LEGACY_ALLOW_PRODUCTION=false
API_TOKEN_ID=
INTERNAL_API_KEY=<fill: long random string>
CRON_KEY=<fill: long random string>
SSO_JWT_KEY=<fill>
SSO_JWT_REQUIRE_EXP=false

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# VNR expense database (restored copy of live for testing)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<fill: e.g. xeasy_test_expense>
DB_USERNAME=<fill>
DB_PASSWORD=<fill>
DB_SOCKET=

# VVNR expense database (restored copy; never the live vnressus_expense)
DB_VVNR_CONNECTION=mysql
DB_VVNR_HOST=127.0.0.1
DB_VVNR_PORT=3306
DB_VVNR_DATABASE=<fill: e.g. xeasy_test_vvnr>
DB_VVNR_USERNAME=<fill>
DB_VVNR_PASSWORD=<fill>

# HRIMS (read-only user)
DB_HRIMS_CONNECTION=mysql
DB_HRIMS_HOST=127.0.0.1
DB_HRIMS_PORT=3306
DB_HRIMS_DATABASE=<fill>
DB_HRIMS_USERNAME=<fill: read-only user>
DB_HRIMS_PASSWORD=<fill>

# Mobile API databases (same restored copies)
MOBILE_DB_HOST=127.0.0.1
MOBILE_DB_PORT=3306
MOBILE_DB_DATABASE=<fill>
MOBILE_DB_USERNAME=<fill>
MOBILE_DB_PASSWORD=<fill>
MOBILE_VVNR_HOST=127.0.0.1
MOBILE_VVNR_PORT=3306
MOBILE_VVNR_DATABASE=<fill>
MOBILE_VVNR_USERNAME=<fill>
MOBILE_VVNR_PASSWORD=<fill>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Bill and odometer images. Test host without the S3 bucket: CLAIM_FILES_LOCAL=true (files in s3_local/).
# With a TEST bucket: CLAIM_FILES_LOCAL=false and the AWS_* keys of that bucket. Never the live bucket.
CLAIM_FILES_LOCAL=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
HRIMS_AWS_DEFAULT_REGION=ap-south-1
HRIMS_AWS_USE_PATH_STYLE_ENDPOINT=true

# Mail: "log" writes mails to storage/logs instead of sending. Switch to smtp only for a planned mail test,
# and keep MAIL_ALLOWED_DOMAINS so test mail reaches company addresses only.
MAIL_ACTIVE=false
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=expense@vnrseeds.com
MAIL_FROM_NAME="Xeasy (test)"
MAIL_ALLOWED_DOMAINS=vnrseeds.com,vnrseeds.in,vnrnursery.in
VEHICLE_RATE_REPORT_TO=

# Push notifications: empty = off on the test host
CENTRAL_NOTIFICATION_BASE_URL=

# Bank (Matrix): mock only on the test host
MATRIX_INTEGRATION_ENABLED=true
MATRIX_MOCK=true
MATRIX_REIMBURSEMENT_ENABLED=true
MATRIX_ADVANCE_ENABLED=true
MATRIX_BASE_URL=
MATRIX_API_KEY=
MATRIX_DEFAULT_BUSINESS_ENTITY=120
SCHEDULE_MATRIX_SYNC=false

# Controls (see deploy/GO_LIVE_ENV.md). Test host = enforce, so testers see what live will do once switched on.
CLAIM_RULES_ENABLED=true
CLAIM_TRANSITIONS_ENFORCE=true
PAYMENT_MAKER_CHECKER=true
PAYMENT_MAKER_CHECKER_MODE=enforce
API_AUTH_ENFORCE=true
MOBILE_API_AUTH_ENFORCE=false
ROUTE_ACCESS_ENFORCE=true
RECORD_ACCESS_ENFORCE=true
AUTH_LOCAL_PASSWORD_LOGIN=false
LEGACY_ZERO_DATES=true

# Scheduler: the queue worker runs from the scheduler (cron line in deploy/README.md)
SCHEDULE_QUEUE_WORKER=true
XEASY_EMPLOYEE_NOTIFICATIONS=true
XEASY_COURIER_REMINDER_DAILY=true
XEASY_COURIER_REMINDER_MAX_DAYS=45

# Allowed browser origins for the API (comma list)
CORS_ALLOWED_ORIGINS=https://xeasy.vnrseeds.co.in

VITE_APP_NAME="${APP_NAME}"

# where employee photos are read from (HR portal)
EMPLOYEE_PHOTO_BASE=https://vnrseeds.co.in/file-view/Employee_Image
